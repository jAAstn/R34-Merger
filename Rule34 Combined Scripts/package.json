    "test:infinite": "node test/infinite-scroll.test.mjs",
    "test:webm": "node test/tag-hider-webm.test.mjs",
    "test:features": "node test/features.test.mjs",
    "test:smoke": "node --no-experimental-webstorage tools/smoke-test.js",
    "test:imports": "node tools/check-imports.mjs"
  },
  "keywords": [],
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "linkedom": "^0.18.13"
  }
